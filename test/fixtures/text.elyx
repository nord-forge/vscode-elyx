use "fonts/Inter-Medium.woff2"
use "fonts/Inter-Bold.woff2"
use "fonts/Fraunces-SemiBold.woff2"

import "./colors.elyx" as colors
import "./foundations.elyx" as typo

// The Brambleway type scale. Every style derives from `body` and only
// declares what differs. Inter carries the interface, Fraunces the trail
// names and big numbers, JetBrains Mono the route snippets.
file {}

export body = text {
  title: "Body",
  caption: "Default text: Inter Medium 16 on 1.4. Every style derives from it.",
  left: 0px,
  top: 0px,
  fill: colors.theme.text,
  contents: "Pack for the weather you expect, then pack for the weather you do not.",
  font-size: typo.fontSize.base,
  font-family: typo.fonts.body,
  font-style: "Medium",
  line-height: typo.lineHeight.normal
}


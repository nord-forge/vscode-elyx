// App header

export appHeader = frame {
  title: "App header",
  caption: "Logo, main navigation, the account avatar and the booking button.",
  meta: {component: "AppHeader"},
  left: 0px,
  top: 760px,
  width: 1200px,
  layout: {align-items: .center, item-gap: scale.space.x6},
  fill: colors.theme.surface,
  shadow: {
    drop-shadow: {
      color: colors.effects.shadowSoft,
      offset: point(0px, 2px),
      blur-radius: 4px
    }
  },
  corner-radius: scale.radius.xl,
  overflow: .visible,
  padding: [scale.space.x3, scale.space.x5],
  children: [logo, navigation],

  logo = text : typography.cardTitle {
    contents: "Brambleway",
    fill[0].color: colors.theme.accent
  }

  navigation = frame {
    width: 100%,
    layout: {justify-content: .space-between, align-items: .center},
    overflow: .visible,
    children: [mainNav, actions]
  }

  mainNav = frame {
    layout: {align-items: .center, item-gap: scale.space.x6},
    overflow: .visible,
    children: [routes, huts, conditions, guides]
  }

  routes = text : navLink {
    contents: "Routes"
  }

  huts = frame : dropdownTrigger {
    overflow: .visible
  }

  conditions = text : navLink {
    contents: "Conditions"
  }

  guides = text : navLink {
    contents: "Guides"
  }

  actions = frame {
    layout: {align-items: .center, item-gap: scale.space.x4},
    children: [account, book]
  }

  account = frame : avatar {}

  book = frame : primaryButton {}
}


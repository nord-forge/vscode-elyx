import "./colors.elyx" as colors
import "./foundations.elyx" as scale
import "./text.elyx" as typography

// The Brambleway component library: buttons, navigation, badges, fields,
// cards and the app header. Screens instance these and override only what
// differs. The board parts at the bottom build the overview in index.elyx.
file {}

// Buttons

export primaryButton = frame {
  title: "Primary button",
  caption: "Moss fill with a white label. One per screen.",
  left: 0px,
  top: 0px,
  layout: {justify-content: .center, align-items: .center},
  fill: colors.theme.accent,
  corner-radius: scale.radius.lg,
  padding: [scale.space.x3, scale.space.x6],
  children: label,

  label = text : typography.buttonLabel {
    contents: "Book a bunk",
    fill[0].color: colors.palette.white
  }
}

@variant
export primaryButtonHover = frame : primaryButton {
  title: "Primary button, hover",

  fill: colors.theme.field,
  border: {color: colors.theme.fieldBorder, width: 1px},
  corner-radius: scale.radius.field,
  padding: [scale.space.x2, scale.space.x2, scale.space.x2, scale.space.x4],
  children: [input, submit],

  input = frame {
    width: 100%,
    layout: {direction: .column, item-gap: scale.space.x1},
    children: placeholder
  }

  placeholder = text : typography.base {
    contents: "Search trails, huts or summits",
    fill[0].color: colors.palette.pebble
  }

  submit = frame : primaryButton {
    padding: [scale.space.x2, scale.space.x4],

    label {
      contents: "Find"
    }
  }
}


    contents: "We could not find that place. Try a nearby town."
  }
}

// Cards

export trailCard = frame {
  title: "Trail card",
  caption: "A route in the results list: photo band, name, badges and stats.",
  meta: {component: "TrailCard"},
  left: 0px,
  top: 440px,
  width: 368px,
  layout: {direction: .column},
  fill: colors.theme.surface,
  shadow: {
    drop-shadow: {
      color: colors.effects.shadowSoft,
      offset: point(0px, 2px),
      blur-radius: 6px
    }
  },
  corner-radius: scale.radius.card,
  overflow: .clip,
  children: [cover, details],

  cover = frame {
    width: 100%,
    height: 160px,
    fill: {
      linear-gradient: {
        angle: 160deg,
        stops: [stop(0%, colors.palette.fern), stop(100%, colors.palette.pine)]
      }
    }
  }

  details = frame {
    width: 100%,
    layout: {direction: .column, item-gap: scale.space.x3},
    padding: scale.space.x5,
    children: [name, badges, stats]
  }

  name = text : typography.cardTitle {
    contents: "Ridge Loop from Hollin Tarn"
  }

  badges = frame {
    layout: {item-gap: scale.space.x2},
    children: [difficulty]
  }

  difficulty = frame : difficultyBadgeModerate {}

  stats = text : typography.small {
    contents: "12.4 km · 640 m ascent · 4 h 30",
    fill[0].color: colors.theme.textMuted
  }
}


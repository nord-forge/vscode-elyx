import "./colors.elyx" as colors
import "./colors.dark.elyx" as colorsdark
import "./foundations.elyx" as scale
import "./text.elyx" as typography
import "./components.elyx" as ui
import "./backgrounds.elyx" as backgrounds
import "./trailGuide.elyx" as guide
import "./nightHike.elyx" as night

// The Brambleway design system at a glance. Every token and component sits
// on a labelled card: its name, then what it is and where it is used. The
// two screens sit below the overview with arrows between them, and the
// night board to the right renders the whole overview with theme=dark.
file {
  draw-connections: .true
}

overview = frame {
  left: 0px,
  top: 0px,
  width: 1440px,
  layout: {direction: .column, item-gap: scale.space.x24},
  fill: colors.theme.page,
  padding: [scale.space.x24, scale.space.x16, scale.space.x32],
  children: [
    intro,
    colourSection,
    typeSection,
    scaleSection,
    componentSection,
    backgroundSection
  ],

  intro = frame {
    width: 100%,
    layout: {direction: .column, item-gap: scale.space.x6},
    children: [introTitle, introText]
  }

  introTitle = text : typography.heroTitle {
    contents: "BRAMBLEWAY\nDESIGN SYSTEM",
    fill[0].color: colors.palette.pine
  }

  introText = text : typography.lead {
    width: 820px,
    contents: "Tokens, type, components and screens for a trail planner with hut bookings. Daylight by default, with a theme=dark context for the night routes."
  }

  colourSection = frame {
    width: 100%,
    layout: {direction: .column, item-gap: scale.space.x6},
    children: [
      colourHeading,
      paletteTitle,
      paletteGrid,
      trailTitle,
      trailGrid,
      themeTitle,
      themeGrid,
      nightTitle,
      nightGrid,
      mapTitle,
      mapGrid,
      weatherTitle,
      weatherGrid,
      syntaxTitle,
      syntaxGrid,
      effectsTitle,
      effectsGrid
    ]
  }

  colourHeading = frame : ui.sectionHeading {
    width: 100%,

    intro {
      contents: "Every colour token, with its name and the value it was authored with. Translucent values show the page through the chip."
    }
  }

  paletteTitle = text : typography.eyebrow {
    contents: "PALETTE",
    fill[0].color: colors.theme.heading
  }

  // Fixed colours. Everything else refers to these.
  paletteGrid = frame {
    width: 100%,
    layout: {
      item-gap: scale.space.x6,
      wrap: .true,
      line-gap: scale.space.x6
    },
    children: [
      paletteMoss,
      paletteFern,
      paletteFernPale,
      palettePine,
      palettePineNight,
      paletteBark,
      paletteClay,
      paletteSand,
      paletteSandLight,
      paletteStone,
      palettePebble,
      paletteSlate,
      paletteSlateLight,
      paletteInk,
      paletteLake,
      paletteLakeDeep,
      paletteSky,
      paletteBerry,
      paletteEmber,
      paletteSun,
      paletteWhite
    ]
  }

  paletteMoss = frame : ui.swatch {
    chip {
      fill[0].color: colors.palette.moss
    }

    name {
      contents: "moss"
    }

    value {
      contents: "#4f7d4a"
    }
  }

  paletteFern = frame : ui.swatch {
    chip {
      fill[0].color: colors.palette.fern
    }

    name {
      contents: "fern"
    }

    value {
      contents: "#7fae6a"
    }
  }

  paletteFernPale = frame : ui.swatch {

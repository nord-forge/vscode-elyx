  scaleSection = frame {
    width: 100%,
    layout: {direction: .column, item-gap: scale.space.x6},
    children: [
      scaleHeading,
      spaceTitle,
      spaceList,
      radiusTitle,
      radiusGrid,
      sizeTitle,
      sizeList,
      leadingTitle,
      leadingList,
      trackingTitle,
      trackingList
    ]
  }

  scaleHeading = frame : ui.sectionHeading {
    width: 100%,

    heading {
      contents: "Space, radius and type scale"
    }

    intro {
      contents: "The numbers in foundations.elyx. One spacing unit is 4px; letter spacing is a percentage of the font size."
    }
  }

  spaceTitle = text : typography.eyebrow {
    contents: "SPACING"

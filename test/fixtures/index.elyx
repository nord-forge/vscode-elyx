      overrides: [
        insert(specAppFooterExample, after = .nil),
        remove(ui.specimen.placeholder)
      ]
    }
  }

  specAppFooterExample = frame : ui.appFooter {
    left: 0px,
    top: 0px
  }

  backgroundSection = frame {
    width: 100%,
    layout: {direction: .column, item-gap: scale.space.x6},
    children: [backgroundHeading, backgroundGrid]
  }

  backgroundHeading = frame : ui.sectionHeading {
    width: 100%,

    heading {
      contents: "Backgrounds"
    }

    intro {
      contents: "Decorative layers, cropped to a 320px window. Screens place them behind content with ignore-stack."
    }
  }

  backgroundGrid = frame {
    width: 100%,
    layout: {item-gap: scale.space.x6, wrap: .true, line-gap: scale.space.x6},
    children: [
      backdropContourBackdrop,
      backdropContourBackdropEmber,
      backdropHeroBackground,
      backdropSummitGlow,
      backdropMapTile
    ]
  }

  backdropContourBackdrop = frame : ui.specimen {
    label {
      contents: "Contour backdrop, moss"
    }

    note {
      contents: "Glow and fading contour grid behind the route planner."
    }

    stage {
      overrides: [
        insert(backdropContourBackdropCrop, after = .nil),
        remove(ui.specimen.placeholder)
      ]
    }
  }

  backdropContourBackdropCrop = frame {
    width: 100%,
    height: 320px,
    corner-radius: scale.radius.lg,
    children: backdropContourBackdropExample
  }

  backdropContourBackdropExample = frame : backgrounds.contourBackdrop {
    left: 0px,
    top: 0px
  }

  backdropContourBackdropEmber = frame : ui.specimen {
    label {
      contents: "Contour backdrop, ember"
    }

    note {
      contents: "Mirrored ember glow for the night screens."
    }

    stage {
      overrides: [
        insert(backdropContourBackdropEmberCrop, after = .nil),
        remove(ui.specimen.placeholder)
      ]
    }
  }

  backdropContourBackdropEmberCrop = frame {
    width: 100%,
    height: 320px,
    corner-radius: scale.radius.lg,
    children: backdropContourBackdropEmberExample
  }

  backdropContourBackdropEmberExample = frame : backgrounds.contourBackdropEmber {
    left: 0px,
    top: 0px
  }

  backdropHeroBackground = frame : ui.specimen {
    label {
      contents: "Hero sky"
    }

    note {
      contents: "Dusk gradient behind the landing hero, fading to the page colour."
    }

    stage {
      overrides: [
        insert(backdropHeroBackgroundCrop, after = .nil),
        remove(ui.specimen.placeholder)
      ]
    }
  }

  backdropHeroBackgroundCrop = frame {
    width: 100%,
    height: 320px,
    corner-radius: scale.radius.lg,
    children: backdropHeroBackgroundExample
  }

  backdropHeroBackgroundExample = frame : backgrounds.heroBackground {
    left: 0px,
    top: 0px
  }

  backdropSummitGlow = frame : ui.specimen {
    label {
      contents: "Summit glow"
    }

    note {
      contents: "Blurred warm glow behind a trail title."
    }

    stage {
      overrides: [
        insert(backdropSummitGlowCrop, after = .nil),
        remove(ui.specimen.placeholder)
      ]
    }
  }

  backdropSummitGlowCrop = frame {
    width: 100%,
    height: 320px,
    corner-radius: scale.radius.lg,
    children: backdropSummitGlowExample
  }

  backdropSummitGlowExample = frame : backgrounds.summitGlow {
    left: 0px,
    top: 0px
  }

  backdropMapTile = frame : ui.specimen {
    label {
      contents: "Map tile"
    }

    note {
      contents: "Terrain colours for the static map preview."
    }

    stage {
      overrides: [
        insert(backdropMapTileCrop, after = .nil),
        remove(ui.specimen.placeholder)
      ]
    }
  }

  backdropMapTileCrop = frame {
    width: 100%,
    height: 320px,
    corner-radius: scale.radius.lg,
    children: backdropMapTileExample
  }

  backdropMapTileExample = frame : backgrounds.mapTile {
    left: 0px,
    top: 0px
  }
}

// The night board: the whole overview again, rendered with theme=dark.
@context(theme="dark")
nightOverview = frame : overview {
  left: 1600px,
  top: 0px,
  fill[0].color: colorsdark.darkTheme.page
}

// The screens, one row below the overview. Arrows are links inside a page
// that go to another screen on this board.
guideBoard = frame : guide.trailGuideScreen {
  left: 0px,
  top: 16000px,

  columns {
    article {
      nextLink {
        connections[0].target: collapsedBoard,
        connections[0].label: "Next chapter"
      }
    }

    sidebar {
      chapterSafety {
        connections[0].target: nightBoard,
        connections[0].label: "Night route"
      }
    }
  }
}

collapsedBoard = frame : guide.trailGuideCollapsed {
  left: 1600px,
  top: 16000px
}

// The night screen is a contextual variant, so it renders with theme=dark
// on this daylight board.
@context(theme="dark")
nightBoard = frame : night.nightHikeScreen {
  left: 3200px,
  top: 16000px,

  body {
    hero {
      heroActions {
        saveRoute {
          connections[0].target: guideBoard,
          connections[0].label: "Read the guide"
        }
      }
    }
  }
}

  typeSection = frame {
    width: 100%,
    layout: {direction: .column, item-gap: scale.space.x6},
    children: [typeHeading, typeGrid]
  }

  typeHeading = frame : ui.sectionHeading {
    width: 100%,

    heading {
      contents: "Type"
    }

    intro {
      contents: "Every text style in text.elyx. Each one derives from Body and only declares what differs."
    }
  }

  typeGrid = frame {
    width: 100%,
    layout: {item-gap: scale.space.x6, wrap: .true, line-gap: scale.space.x6},
    children: [
      typeBody,
      typeProse,
      typeBodyStrong,
      typeLead,
      typeBase,
      typeSmall,
      typeMuted,
      typeCaption,
      typeEyebrow,
      typeHeading,
      typeSubheading,
      typeLink,
      typeCode,
      typeDisplay,
      typeHeroTitle,
      typeCardTitle,
      typeStatValue,
      typeStatLabel,
      typeMapLabel,
      typeErrorText,
      typeButtonLabel
    ]
  }

  typeBody = frame : ui.specimen {
    label {
      contents: "Body"
    }

    note {
      contents: "Default text: Inter Medium 16 on 1.4. Every style derives from it."
    }

    stage {
      overrides: [
        insert(typeBodyExample, after = .nil),
        remove(ui.specimen.placeholder)
      ]
    }
  }

  typeBodyExample = text : typography.body {
    left: 0px,
    top: 0px
  }

  typeProse = frame : ui.specimen {
    width: 760px,

    label {
      contents: "Prose"
    }

